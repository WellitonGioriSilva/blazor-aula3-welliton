@page "/produtos"

<h3>Produtos</h3>
<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Cadastrar produto">
            <FormProduto AoAdicionar="AdicionarProduto" />
        </Cartao>
    </div>
    <div class="col-md-8">
        @if (produtos.Count > 0)
        {
            <TabelaProdutos Produtos="produtos" />
        }
        else
        {
            <AvisoErro Mensagem="Nenhum produto cadastrado." />
        }
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    private void AdicionarProduto(Produto produto)
    {
        produtos.Add(produto);
    }
}
